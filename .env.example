# Copy to .env at the project root. Never commit your real .env.
# No credentials or extra services are needed to try the demo or inspect public GitHub accounts.

# SQLite is automatic. Set DATABASE_URL only to use a different location or PostgreSQL.
# DATABASE_URL=sqlite:///data/codepulse.db
# DATABASE_URL=postgresql://codepulse:change-me@localhost:5432/codepulse
CODEPULSE_DATA_DIR=data

# Keep these exact origins consistent with the URLs used in your browser.
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false

# Optional GitHub OAuth. Register an OAuth App at https://github.com/settings/developers
# Homepage URL: http://localhost:5173
# Authorization callback URL: http://localhost:8000/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Private repository access requires explicit opt-in and an OAuth repo permission grant.
GITHUB_INCLUDE_PRIVATE=false

# Optional, at least 32 characters. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Local runs generate and retain a key in data/.secret automatically.
# Set a persistent, private SECRET_KEY explicitly in production.
SECRET_KEY=

# Bounded sampling protects sync latency and GitHub rate limits.
GITHUB_MAX_REPOS=12
GITHUB_MAX_COMMITS_PER_REPO=200
GITHUB_MAX_PULL_REQUESTS=200
# Omit to use automatic budgets (50 unauthenticated / 400 authenticated).
# GITHUB_REQUEST_BUDGET=50

# Optional Redis queue for worker/scheduler services; not needed for normal foreground sync.
# REDIS_URL=redis://localhost:6379/0
